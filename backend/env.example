# Django Environment Variables
# Copy this to .env in backend/ directory

# Secret Key - Generate a new one for production!
# Use: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-change-this-in-production

# Debug Mode - MUST be False in production
DEBUG=False

# Allowed Hosts - Add your domain(s)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# CORS Allowed Origins - Add your frontend domain(s)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database Configuration
# For SQLite (default - not recommended for production):
# Leave DATABASE_URL empty or unset

# For MySQL:
# DATABASE_URL=mysql://username:password@localhost/dbname

# For PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost/dbname

